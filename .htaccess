# Safety net for shared hosting where the document root cannot point at /public.
# The recommended setup is still: document root -> <project>/public
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git, ...) or internal folders.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|artisan|phpunit\.xml|package\.json)$ - [F,L]

    # Everything else is served from /public.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
