              "widgetType": "html",
              "settings": {
                "html": "<style>.dmit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}@media(max-width:1200px){.dmit-grid{grid-template-columns:repeat(2,1fr);}}@media(max-width:767px){.dmit-grid{grid-template-columns:1fr;}}</style><div class=\"dmit-grid\"><div style=\"background:#fff;border-radius:16px;overflow:hidden;border:1px solid #E5E7EB;transition:box-shadow .2s;\" onmouseover=\"this.style.boxShadow='0 12px 40px rgba(0,0,0,.12)'\" onmouseout=\"this.style.boxShadow='none'\"><div style=\"position:relative;\"><img src=\"https://picsum.photos/seed/course1/400/220\" style=\"width:100%;height:200px;object-fit:cover;display:block;\" alt=\"Course\" /><span style=\"position:absolute;top:12px;left:12px;background:linear-gradient(135deg,#2563EB,#7C3AED);color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:50px;font-family:Outfit,sans-serif;\">Bestseller</span></div><div style=\"padding:20px;\"><div style=\"font-size:12px;font-weight:600;color:#2563EB;text-transform:uppercase;letter-spacing:.06em;font-family:Outfit,sans-serif;margin-bottom:8px;\">Digital Marketing</div><h3 style=\"font-size:16px;font-weight:700;color:#1A1A2E;font-family:Outfit,sans-serif;margin-bottom:12px;line-height:1.4;\">Digital Marketing Masterclass</h3><div style=\"display:flex;align-items:center;gap:8px;margin-bottom:12px;\"><img src=\"https://picsum.photos/seed/inst1/50/50\" style=\"width:28px;height:28px;border-radius:50%;object-fit:cover;\" /><span style=\"font-size:13px;color:#6B7280;font-family:Outfit,sans-serif;\">Kamal Perera</span></div><div style=\"display:flex;gap:12px;font-size:12px;color:#9CA3AF;font-family:Outfit,sans-serif;margin-bottom:16px;\"><span>&#9201; 12 Weeks</span><span>&#128246; Beginner &#8211; Advanced</span><span>&#128101; 1,240</span></div><div style=\"border-top:1px solid #F3F4F6;padding-top:16px;display:flex;align-items:center;justify-content:space-between;\"><div style=\"font-size:18px;font-weight:800;color:#1A1A2E;font-family:Outfit,sans-serif;\">LKR 14,990</div><a href=\"courses/digital-marketing-masterclass/\" style=\"background:#0F172A;color:#fff;font-size:13px;font-weight:600;padding:8px 18px;border-radius:50px;text-decoration:none;font-family:Outfit,sans-serif;\">Enroll &#8594;</a></div></div></div><div style=\"background:#fff;border-radius:16px;overflow:hidden;border:1px solid #E5E7EB;transition:box-shadow .2s;\" onmouseover=\"this.style.boxShadow='0 12px 40px rgba(0,0,0,.12)'\" onmouseout=\"this.style.boxShadow='none'\"><div style=\"position:relative;\"><img src=\"https://picsum.photos/seed/course2/400/220\" style=\"width:100%;height:200px;object-fit:cover;display:block;\" alt=\"Course\" /><span style=\"position:absolute;top:12px;left:12px;background:linear-gradient(135deg,#2563EB,#7C3AED);color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:50px;font-family:Outfit,sans-serif;\">Top Rated</span></div><div style=\"padding:20px;\"><div style=\"font-size:12px;font-weight:600;color:#2563EB;text-transform:uppercase;letter-spacing:.06em;font-family:Outfit,sans-serif;margin-bottom:8px;\">SEO &amp; Content</div><h3 style=\"font-size:16px;font-weight:700;color:#1A1A2E;font-family:Outfit,sans-serif;margin-bottom:12px;line-height:1.4;\">SEO Mastery</h3><div style=\"display:flex;align-items:center;gap:8px;margin-bottom:12px;\"><img src=\"https://picsum.photos/seed/inst2/50/50\" style=\"width:28px;height:28px;border-radius:50%;object-fit:cover;\" /><span style=\"font-size:13px;color:#6B7280;font-family:Outfit,sans-serif;\">Nimasha Silva</span></div><div style=\"display:flex;gap:12px;font-size:12px;color:#9CA3AF;font-family:Outfit,sans-serif;margin-bottom:16px;\"><span>&#9201; 8 Weeks</span><span>&#128246; Beginner</span><span>&#128101; 980</span></div><div style=\"border-top:1px solid #F3F4F6;padding-top:16px;display:flex;align-items:center;justify-content:space-between;\"><div style=\"font-size:18px;font-weight:800;color:#1A1A2E;font-family:Outfit,sans-serif;\">LKR 9,990</div><