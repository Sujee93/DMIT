            {
              "id": "cd_related_grid_w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:24px;font-family:Outfit,sans-serif;\">\n  <div style=\"border:1.5px solid #E5E7EB;border-radius:20px;overflow:hidden;background:#fff;\">\n    <div style=\"position:relative;\">\n      <img src=\"https://picsum.photos/seed/course2/400/220\" alt=\"SEO Course\" style=\"width:100%;height:180px;object-fit:cover;display:block;\" />\n      <div style=\"position:absolute;top:12px;left:12px;background:#EDE9FE;color:#7C3AED;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;\">SEO</div>\n    </div>\n    <div style=\"padding:20px;\">\n      <h3 style=\"font-size:16px;font-weight:700;color:#0F172A;margin:0 0 12px;line-height:1.3;\">SEO &amp; Content Marketing Pro</h3>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n        <div style=\"font-size:18px;font-weight:800;color:#0F172A;\">LKR 9,990</div>\n        <a href=\"/course-details\" style=\"background:#0F172A;color:#fff;padding:8px 16px;border-radius:50px;font-size:12px;font-weight:600;text-decoration:none;\">Enroll</a>\n      </div>\n    </div>\n  </div>\n  <div style=\"border:1.5px solid #E5E7EB;border-radius:20px;overflow:hidden;background:#fff;\">\n    <div style=\"position:relative;\">\n      <img src=\"https://picsum.photos/seed/course3/400/220\" alt=\"Google Ads Course\" style=\"width:100%;height:180px;object-fit:cover;display:block;\" />\n      <div style=\"position:absolute;top:12px;left:12px;background:#DBEAFE;color:#2563EB;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;\">Google Ads</div>\n    </div>\n    <div style=\"padding:20px;\">\n      <h3 style=\"font-size:16px;font-weight:700;color:#0F172A;margin:0 0 12px;line-height:1.3;\">Google Ads &amp; PPC Mastery</h3>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n        <div style=\"font-size:18px;font-weight:800;color:#0F172A;\">LKR 11,990</div>\n        <a href=\"/course-details\" style=\"background:#0F172A;color:#fff;padding:8px 16px;border-radius:50px;font-size:12px;font-weight:600;text-decoration:none;\">Enroll</a>\n      </div>\n    </div>\n  </div>\n  <div style=\"border:1.5px solid #E5E7EB;border-radius:20px;overflow:hidden;background:#fff;\">\n    <div style=\"position:relative;\">\n      <img src=\"https://picsum.photos/seed/course4/400/220\" alt=\"Social Media Course\" style=\"width:100%;height:180px;object-fit:cover;display:block;\" />\n      <div style=\"position:absolute;top:12px;left:12px;background:#FCE7F3;color:#DB2777;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;\">Social Media</div>\n    </div>\n    <div style=\"padding:20px;\">\n      <h3 style=\"font-size:16px;font-weight:700;color:#0F172A;margin:0 0 12px;line-height:1.3;\">Social Media Marketing</h3>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n        <div style=\"font-size:18px;font-weight:800;color:#0F172A;\">LKR 8,990</div>\n        <a href=\"/course-details\" style=\"background:#0F172A;color:#fff;padding:8px 16px;border-radius:50px;font-size:12px;font-weight:600;text-decoration:none;\">Enroll</a>\n      </div>\n    </div>\n  </div>\n</div>"
