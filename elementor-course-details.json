            "_column_size": 62,
            "width": "62"
          },
          "elements": [
            {
              "id": "cd_content_w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"font-family:Outfit,sans-serif;\">\n  <!-- What you'll learn -->\n  <div style=\"margin-bottom:40px;padding:28px;background:#F0F4FF;border-radius:20px;\">\n    <h2 style=\"font-size:22px;font-weight:800;color:#0F172A;margin:0 0 20px;\">What You'll Learn</h2>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>Complete digital marketing strategy</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>SEO &amp; content marketing mastery</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>Google Ads &amp; Facebook Ads</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>Social media management</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>Email marketing automation</div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#374151;\"><span style=\"color:#2563EB;font-weight:700;flex-shrink:0;margin-top:1px;\">&#10003;</span>Analytics &amp; reporting</div>\n    </div>\n  </div>\n\n  <!-- Curriculum -->\n  <div style=\"margin-bottom:40px;\">\n    <h2 style=\"font-size:22px;font-weight:800;color:#0F172A;margin:0 0 20px;\">Course Curriculum</h2>\n    <div style=\"border:1.5px solid #E5E7EB;border-radius:16px;overflow:hidden;\">\n      <div style=\"border-bottom:1px solid #E5E7EB;\">\n        <div style=\"padding:18px 20px;display:flex;justify-content:space-between;align-items:center;background:#F9FAFB;\">\n          <div><span style=\"font-weight:700;color:#0F172A;font-size:15px;\">Module 1: Digital Marketing Fundamentals</span><span style=\"margin-left:12px;font-size:12px;color:#6B7280;\">5 lessons &middot; 3 hours</span></div>\n          <span style=\"font-size:18px;color:#6B7280;font-weight:700;\">+</span>\n        </div>\n        <div style=\"padding:16px 20px;background:#fff;border-top:1px solid #F3F4F6;\">\n          <div style=\"display:flex;flex-direction:column;gap:8px;font-size:13px;color:#6B7280;\">\n            <div>&#128249; Introduction to Digital Marketing</div>\n            <div>&#128249; The Digital Marketing Ecosystem</div>\n            <div>&#128249; Setting Marketing Goals &amp; KPIs</div>\n            <div>&#128196; Customer Journey Mapping</div>\n            <div>&#9989; Module 1 Quiz</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"border-bottom:1px solid #E5E7EB;\">\n        <div style=\"padding:18px 20px;display:flex;justify-content:space-between;align-items:center;\">\n          <div><span style=\"font-weight:700;color:#0F172A;font-size:15px;\">Module 2: SEO Mastery</span><span style=\"margin-left:12px;font-size:12px;color:#6B7280;\">6 lessons &middot; 4 hours</span></div>\n          <span style=\"font-size:18px;color:#6B7280;font-weight:700;\">+</span>\n        </div>\n      </div>\n      <div style=\"border-bottom:1px solid #E5E7EB;\">\n        <div style=\"padding:18px 20px;display:flex;justify-content:space-between;align-items:center;\">\n          <div><span style=\"font-weight:700;color:#0F172A;font-size:15px;\">Module 3: Google Ads &amp; Paid Search</span><span style=\"margin-left:12px;font-size:12px;color:#6B7280;\">5 lessons &middot; 3.5 hours</span></div>\n          <span style=\"font-size:18px;color:#6B7280;font-weight:700;\">+</span>\n        </div>\n      </div>\n      <div style=\"border-bottom:1px solid #E5E7EB;\">\n        <div style=\"padding:18px 20px;display:flex;justify-content:space-between;align-items:center;\">\n          <div><span style=\"font-weight:700;color:#0F172A;font-size:15px;\">Module 4: Social Media Strategy</span><span style=\"margin-left:12px;font-size:12px;color:#6B7280;\">6 lessons &middot; 4 hours</span></div>\n          <span style=\"font-size:18px;color:#6B7280;font-weight:700;\">+</span>\n        </div>\n      </div>\n      <div>\n        <div style=\"padding:18px 20px;display:flex;justify-content:space-between;align-items:center;\">\n          <div><span style=\"font-weight:700;color:#0F172A;font-size:15px;\">Module 5: Analytics &amp; Reporting</span><span style=\"margin-left:12px;font-size:12px;color:#6B7280;\">4 lessons &middot; 2.5 hours</span></div>\n          <span style=\"font-size:18px;color:#6B7280;font-weight:700;\">+</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Requirements -->\n  <div style=\"margin-bottom:40px;\">\n    <h2 style=\"font-size:22px;font-weight:800;color:#0F172A;margin:0 0 16px;\">Requirements</h2>\n    <ul style=\"padding-left:20px;color:#6B7280;font-size:14px;line-height:1.9;margin:0;\">\n      <li>Basic computer literacy</li>\n      <li>Access to a computer or laptop</li>\n      <li>No prior marketing experience needed</li>\n      <li>Willingness to practice on real projects</li>\n    </ul>\n  </div>\n\n  <!-- Instructor -->\n  <div>\n    <h2 style=\"font-size:22px;font-weight:800;color:#0F172A;margin:0 0 16px;\">Your Instructor</h2>\n    <div style=\"display:flex;gap:20px;align-items:flex-start;padding:24px;border:1.5px solid #E5E7EB;border-radius:16px;\">\n      <img src=\"https://picsum.photos/seed/team1/100/100\" style=\"width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;\" />\n      <div>\n        <div style=\"font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px;\">Kamal Perera</div>\n        <div style=\"font-size:13px;color:#7C3AED;font-weight:600;margin-bottom:10px;\">Founder &amp; CEO &middot; Digital Marketing Expert</div>\n        <p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">15+ years of international digital marketing experience. Formerly at Google and Meta. Has personally trained over 2,000 students and led campaigns for Fortune 500 brands.</p>\n      </div>\n    </div>\n  </div>\n</div>"
              }
            }
          ]
        },
