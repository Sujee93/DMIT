            {
              "id": "cd_enroll_w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"position:sticky;top:100px;font-family:Outfit,sans-serif;\">\n  <div style=\"border:1.5px solid #E5E7EB;border-radius:24px;overflow:hidden;background:#fff;box-shadow:0 8px 40px rgba(0,0,0,0.1);\">\n    <img src=\"https://picsum.photos/seed/course1/400/220\" alt=\"Course Preview\" style=\"width:100%;height:200px;object-fit:cover;display:block;\" />\n    <div style=\"padding:28px;\">\n      <div style=\"font-size:34px;font-weight:900;color:#0F172A;margin-bottom:2px;\">LKR 14,990</div>\n      <div style=\"font-size:13px;color:#6B7280;margin-bottom:20px;\">One-time payment &middot; Lifetime access</div>\n      <a href=\"/contact\" style=\"display:block;width:100%;background:linear-gradient(135deg,#2563EB,#7C3AED);color:#fff;padding:15px;border-radius:50px;text-align:center;font-weight:700;font-size:15px;text-decoration:none;box-sizing:border-box;margin-bottom:12px;font-family:Outfit,sans-serif;\">Enroll Now &rarr;</a>\n      <a href=\"/contact\" style=\"display:block;width:100%;border:1.5px solid #E5E7EB;color:#0F172A;padding:13px;border-radius:50px;text-align:center;font-weight:600;font-size:14px;text-decoration:none;box-sizing:border-box;margin-bottom:24px;font-family:Outfit,sans-serif;\">Book Free Demo Class</a>\n      <div style=\"font-size:12px;font-weight:700;color:#0F172A;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.05em;\">This Course Includes:</div>\n      <ul style=\"list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:9px;font-size:13px;color:#6B7280;\">\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span style=\"color:#2563EB;\">&#128249;</span> 48 hours of HD video content</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#128196;</span> 30 downloadable resources</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#127919;</span> 8 real-world projects</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#128172;</span> Live Q&amp;A sessions weekly</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#9854;</span> Lifetime course access</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#128241;</span> Mobile &amp; desktop access</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#127942;</span> Certificate of completion</li>\n        <li style=\"display:flex;gap:8px;align-items:center;\"><span>&#128188;</span> Job placement assistance</li>\n      </ul>\n    </div>\n  </div>\n</div>"
              }
            }
          ]
        }
      ]
    },
