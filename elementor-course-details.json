              "id": "cd_hero_w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"font-family:Outfit,sans-serif;max-width:900px;\">\n  <div style=\"font-size:13px;color:#6B7280;margin-bottom:20px;\"><a href=\"/\" style=\"color:#6B7280;text-decoration:none;\">Home</a> / <a href=\"/courses\" style=\"color:#6B7280;text-decoration:none;\">Courses</a> / <span style=\"color:#0F172A;\">Digital Marketing Masterclass</span></div>\n  <div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px;\">\n    <span style=\"background:#EDE9FE;color:#7C3AED;padding:4px 14px;border-radius:50px;font-size:12px;font-weight:700;\">Digital Marketing</span>\n    <span style=\"background:#FEF3C7;color:#D97706;padding:4px 14px;border-radius:50px;font-size:12px;font-weight:700;\">&#11088; Bestseller</span>\n  </div>\n  <h1 style=\"font-size:42px;font-weight:800;color:#0F172A;margin:0 0 16px;line-height:1.2;\">Digital Marketing Masterclass</h1>\n  <p style=\"color:#6B7280;font-size:16px;line-height:1.7;max-width:700px;margin:0 0 24px;\">Master every aspect of digital marketing from SEO and PPC to social media and analytics. The most comprehensive digital marketing course in Sri Lanka.</p>\n  <div style=\"display:flex;gap:24px;flex-wrap:wrap;font-size:14px;color:#6B7280;\">\n    <span>&#11088; <strong style=\"color:#0F172A;\">4.9</strong> (328 reviews)</span>\n    <span>&#128101; <strong style=\"color:#0F172A;\">1,240 students</strong></span>\n    <span>&#9201; <strong style=\"color:#0F172A;\">12 Weeks</strong></span>\n    <span>&#128202; <strong style=\"color:#0F172A;\">Beginner &ndash; Advanced</strong></span>\n    <span>&#127942; <strong style=\"color:#0F172A;\">Certificate Included</strong></span>\n  </div>\n</div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cd_main_sec",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "_padding": {
