              "settings": {
                "html": "<div style=\"border-radius:24px;overflow:hidden;\"><img src=\"https://picsum.photos/seed/dmit-story/600/440\" alt=\"DMIT Campus\" style=\"width:100%;height:440px;object-fit:cover;display:block;\" /></div>"
              }
            }
