              "settings": {
                "html": "<div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:24px;font-family:Outfit,sans-serif;max-width:1100px;margin:0 auto;padding:0 40px;\"><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">🎯</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Practical Learning</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">Every course includes real-world projects, live campaigns, and portfolio-building exercises.</p></div><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">🌐</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Industry-Relevant</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">Curriculum co-designed with industry leaders and updated quarterly to reflect the latest trends.</p></div><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">🤝</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Student Success</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">From enrollment to career placement, we support students every step with mentorship and job placement.</p></div><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">🔓</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Accessible Education</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">Flexible payment plans, scholarships, and online learning options for everyone.</p></div><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">📊</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Data-Driven</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">We track student outcomes, completion rates, and job placement stats to continuously improve.</p></div><div style=\"background:#fff;border:1.5px solid #E5E7EB;border-radius:20px;padding:28px;\"><div style=\"font-size:32px;margin-bottom:12px;\">🚀</div><div style=\"font-size:17px;font-weight:700;color:#0F172A;margin-bottom:10px;\">Innovation First</div><p style=\"color:#6B7280;font-size:14px;line-height:1.7;margin:0;\">We embrace new platforms, AI tools, and emerging technologies in every course we deliver.</p></div></div>"
