APP_NAME="Shoe Distribution"
APP_ENV=production
APP_KEY=
# Never enable debug on a live server - it exposes stack traces & config.
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shoe_distribution
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Database sessions survive deploys and can be invalidated server side.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# Set to true when the site is served over HTTPS (recommended).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Initial administrator created by `php artisan db:seed`.
# If ADMIN_PASSWORD is empty a strong random password is generated and printed once.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
