APP_NAME="Shoe Distribution"
APP_ENV=production
APP_KEY=
# Never enable debug on a live server - it exposes stack traces & config.
APP_DEBUG=false
# Must match the address you open in the browser (http://localhost:8000 when testing locally).
APP_URL=http://localhost:8000
# true only if the site is on HTTPS behind a proxy/CDN and links come out as http://
FORCE_HTTPS=false
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shoe_distribution
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Database sessions survive deploys and can be invalidated server side.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# Leave empty: cookies become secure-only automatically when served over HTTPS.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Initial administrator created by `php artisan db:seed`.
# If ADMIN_PASSWORD is empty a strong random password is generated and printed once.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
