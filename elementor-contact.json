            },
            {
              "id": "con_hero_h1",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "We're Here To <span style=\"background:linear-gradient(135deg,#2563EB 0%,#7C3AED 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\">Help!</span>",
                "header_size": "h1",
