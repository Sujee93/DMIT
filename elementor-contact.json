                "html": "<div style=\"text-align:center;\"><div style=\"display:inline-block;background:#EDE9FE;color:#7C3AED;padding:6px 16px;border-radius:50px;font-size:13px;font-weight:600;font-family:Outfit,sans-serif;margin-bottom:16px;\">📬 Contact Us</div></div>"
