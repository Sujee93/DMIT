    {
      "id": "con_form_sec",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "0",
          "bottom": "60",
          "left": "0",
          "isLinked": false
        }
      },
      "elements": [
        {
          "id": "con_form_col",
          "elType": "column",
          "settings": {
            "width": {
              "unit": "%",
              "size": 55
            },
            "column_padding": {
              "unit": "px",
              "top": "0",
              "right": "15",
              "bottom": "0",
              "left": "15",
              "isLinked": false
            }
          },
          "elements": [
            {
              "id": "con_form_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"background:#F9FAFB;border:1.5px solid #E5E7EB;border-radius:24px;padding:40px;font-family:Outfit,sans-serif;\">\n  <h2 style=\"font-size:28px;font-weight:800;color:#0F172A;margin:0 0 8px;\">Send Us A Message</h2>\n  <p style=\"color:#6B7280;font-size:15px;margin:0 0 28px;\">Fill out the form below and we'll get back to you as soon as possible.</p>\n  <form>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;\">\n      <div>\n        <label style=\"display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;\">Full Name</label>\n        <input type=\"text\" placeholder=\"John Doe\" style=\"width:100%;padding:12px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:Outfit,sans-serif;outline:none;box-sizing:border-box;background:#fff;\" />\n      </div>\n      <div>\n        <label style=\"display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;\">Email</label>\n        <input type=\"email\" placeholder=\"you@example.com\" style=\"width:100%;padding:12px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:Outfit,sans-serif;outline:none;box-sizing:border-box;background:#fff;\" />\n      </div>\n    </div>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;\">\n      <div>\n        <label style=\"display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;\">Phone</label>\n        <input type=\"tel\" placeholder=\"+94 77 000 0000\" style=\"width:100%;padding:12px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:Outfit,sans-serif;outline:none;box-sizing:border-box;background:#fff;\" />\n      </div>\n      <div>\n        <label style=\"display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;\">Course of Interest</label>\n        <select style=\"width:100%;padding:12px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:Outfit,sans-serif;outline:none;box-sizing:border-box;background:#fff;color:#374151;\">\n          <option value=\"\">Select a course...</option>\n          <option>Digital Marketing Masterclass</option>\n          <option>SEO &amp; Content Marketing</option>\n          <option>Google Ads &amp; PPC</option>\n          <option>Social Media Marketing</option>\n          <option>Web Development</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"margin-bottom:24px;\">\n      <label style=\"display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;\">Message</label>\n      <textarea placeholder=\"Tell us about yourself and what you'd like to achieve...\" rows=\"4\" style=\"width:100%;padding:12px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:Outfit,sans-serif;outline:none;box-sizing:border-box;resize:vertical;background:#fff;\"></textarea>\n    </div>\n    <button type=\"submit\" style=\"width:100%;background:#0F172A;color:#fff;padding:14px;border:none;border-radius:50px;font-size:15px;font-weight:700;font-family:Outfit,sans-serif;cursor:pointer;\">Send Message →</button>\n  </form>\n</div>"
              }
            }
          ]
        },
        {
          "id": "con_info_col",
          "elType": "column",
          "settings": {
            "width": {
              "unit": "%",
              "size": 45
            },
            "column_padding": {
              "unit": "px",
              "top": "0",
              "right": "15",
              "bottom": "0",
              "left": "15",
              "isLinked": false
            }
          },
          "elements": [
            {
              "id": "con_info_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"display:flex;flex-direction:column;gap:16px;font-family:Outfit,sans-serif;padding-left:24px;\">\n  <div style=\"background:#EDE9FE;border-radius:20px;padding:28px;display:flex;gap:18px;align-items:flex-start;\">\n    <div style=\"width:52px;height:52px;background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;\">✉️</div>\n    <div>\n      <div style=\"font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px;\">Email Us</div>\n      <div style=\"font-size:13px;color:#6B7280;margin-bottom:8px;\">Email us for scheduling or inquiries</div>\n      <div style=\"font-size:14px;font-weight:600;color:#0F172A;\">info@dmit.lk</div>\n      <div style=\"font-size:14px;font-weight:600;color:#0F172A;\">admissions@dmit.lk</div>\n    </div>\n  </div>\n  <div style=\"background:#FEF0EC;border-radius:20px;padding:28px;display:flex;gap:18px;align-items:flex-start;\">\n    <div style=\"width:52px;height:52px;background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;\">📍</div>\n    <div>\n      <div style=\"font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px;\">Visit Our Office</div>\n      <div style=\"font-size:13px;color:#6B7280;margin-bottom:8px;\">Visit us for enrollment or a demo class</div>\n      <div style=\"font-size:14px;font-weight:600;color:#0F172A;\">No. 45, Galle Road, Colombo 03, Sri Lanka</div>\n      <div style=\"font-size:13px;color:#6B7280;margin-top:4px;\">Mon – Sat: 8:00 AM – 6:00 PM</div>\n    </div>\n  </div>\n  <div style=\"background:#E6FAF5;border-radius:20px;padding:28px;display:flex;gap:18px;align-items:flex-start;\">\n    <div style=\"width:52px;height:52px;background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;\">📞</div>\n    <div>\n      <div style=\"font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px;\">Call Us</div>\n      <div style=\"font-size:13px;color:#6B7280;margin-bottom:8px;\">Call us during office hours</div>\n      <div style=\"font-size:14px;font-weight:600;color:#0F172A;\">+94 11 234 5678</div>\n      <div style=\"font-size:14px;font-weight:600;color:#0F172A;\">+94 77 890 1234</div>\n    </div>\n  </div>\n</div>"
              }
            }
          ]
        }
      ]
